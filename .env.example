PORT=3000

# Supabase (PostgreSQL) 연결 문자열 — Supabase 대시보드 > Connect 에서 복사
DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# 개발용 스키마 자동 생성 (운영에서는 false)
DB_SYNCHRONIZE=true

# JWT
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES_IN_SEC=3600
JWT_REFRESH_EXPIRES_IN_SEC=1209600

# 소셜 로그인 (설정하면 다른 앱에서 발급된 토큰을 거부한다)
KAKAO_APP_ID=
GOOGLE_CLIENT_ID=

# 공유 URL 도메인
SHARE_BASE_URL=https://오늘어디서팔아요.kr
