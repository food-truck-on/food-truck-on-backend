PORT=3000

# Supabase (PostgreSQL) 연결 문자열 — Supabase 대시보드 > Connect 에서 복사
DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# 개발용 스키마 자동 생성 (운영에서는 false)
DB_SYNCHRONIZE=true

# JWT
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES_IN_SEC=3600
JWT_REFRESH_EXPIRES_IN_SEC=1209600

# 소셜 로그인 (OAuth Authorization Code)
# 이 서버의 공개 주소. 제공자 콘솔에 {API_BASE_URL}/api/v1/auth/{kakao|google}/callback 을 Redirect URI 로 등록한다.
API_BASE_URL=http://localhost:3000
# 로그인 후 ?code= (실패 시 ?error=) 를 붙여 보낼 프론트엔드 주소
FRONTEND_LOGIN_REDIRECT_URL=http://localhost:3000/auth/callback
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 가상 데이터 (npm run seed, 규칙: docs/SEED_DATA.md) — 비워 두면 서울시청 주변, 7일치
SEED_LAT=
SEED_LNG=
SEED_DAYS=

# 공유 URL 도메인
SHARE_BASE_URL=https://오늘어디서팔아요.kr
